<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="com.example.loot_proyect">

        <description>Loot</description>

        <class>com.example.loot_proyect.model.UsuarioEntity</class>
        <class>com.example.loot_proyect.model.CategoriaEntity</class>
        <class>com.example.loot_proyect.model.DireccionEntity</class>
        <class>com.example.loot_proyect.model.ProductoEntity</class>
        <class>com.example.loot_proyect.model.ResenaEntity</class>
        <class>com.example.loot_proyect.model.VentaEntity</class>

        <properties>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MySQLDialect"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/Loot"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="1234"/>

        </properties>

    </persistence-unit>

</persistence>