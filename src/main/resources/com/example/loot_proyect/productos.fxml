<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox layoutX="25.0" layoutY="20.0" prefWidth="400.0" spacing="12.0" stylesheets="@estilos_loot.css">

            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Productos" />

            <Separator />

            <Label text="Nombre:" />
            <TextField promptText="Ej. Producto" />

            <Label text="Precio:" />
            <TextField promptText="Ej. 100.00" />

            <Label text="Categoría:" />
            <ComboBox opacity="0.67" promptText="Selecciona categoría" styleClass="boton-loot" stylesheets="@estilos_loot.css" />

            <Label text="Descripción:" />
            <TextArea prefHeight="100" promptText="Descripción del producto..." />

            <HBox spacing="10">
                <Button styleClass="boton-loot" text="Guardar" />
                <Button styleClass="boton-loot" text="Limpiar" />
            </HBox>

        </VBox>
    </children>
   <stylesheets>
      <URL value="@estilos_loot.css" />
      <URL value="@estilos_loot.css" />
   </stylesheets>
</AnchorPane>
