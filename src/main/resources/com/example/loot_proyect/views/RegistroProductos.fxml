<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="450.0" stylesheets="@../styles/estilos_loot.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loot_proyect.controllers.RegistroProductosController">
    <children>
        <VBox layoutX="0.0" layoutY="0.0" prefWidth="450.0" spacing="10.0" stylesheets="@../styles/estilos_loot.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
            <Button fx:id="RegresarProductos" mnemonicParsing="false" prefHeight="26.0" prefWidth="79.0" text="REGRESAR" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Productos" />
                <Separator />

                <Label text="Nombre:" />
                <TextField fx:id="txtNombre" promptText="Ej. Producto" />

                <Label text="Precio:" />
                <TextField fx:id="txtPrecio" promptText="Ej. 100.00" />

                <Label text="Categoría:" />
                <ComboBox fx:id="cmbCategoria" opacity="0.67" promptText="Selecciona categoría" styleClass="boton-loot" stylesheets="@../styles/estilos_loot.css" />

                <Label text="Descripción:" />
                <TextArea fx:id="txtDescripcion" prefHeight="80.0" promptText="Descripción del producto..." />

                <HBox spacing="10">
                    <children>
                        <Button onAction="#btnGuardarClick" styleClass="boton-loot" text="Guardar" />
                        <Button onAction="#btnLimpiarClick" styleClass="boton-loot" text="Limpiar" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
