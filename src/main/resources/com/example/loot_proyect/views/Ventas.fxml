<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0" prefWidth="800.0" style="-fx-background-color: #f4f4f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loot_proyect.controllers.MenuVentasController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" style="-fx-background-color: #ffffff; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
            <children>
                <Label text="Marketplace">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnIrA_Registro" mnemonicParsing="false" onAction="#IrARegistroProducto" prefWidth="80.0" text="Venta" />

                        <Button fx:id="btnPerfil" mnemonicParsing="false" onAction="#IrAPerfil" prefWidth="80.0" text="Perfil" />

                        <Button fx:id="RegresarMenuVentas" mnemonicParsing="false" onAction="#Regresarclick" style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828;" text="Salir" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: #eaeaea;">
            <children>
                <Label text="Buscar:">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="¿Qué artículo deseas?" />
                <Button mnemonicParsing="false" text="Aceptar" />
            </children>
            <padding>
                <Insets left="20.0" />
            </padding>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="contenedorCatalogo" spacing="12.0" style="-fx-padding: 20;" />
            </content>
        </ScrollPane>
    </children>
</VBox>